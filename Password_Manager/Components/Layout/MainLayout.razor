@inherits LayoutComponentBase
@inject SessionService Session

<div class="app-shell"
     @onmousemove="OnUserInteraction"
     @onkeydown="OnUserInteraction"
     @onclick="OnUserInteraction">

    <header class="topbar">
        <div class="brand">LocalVault</div>

        <AuthorizeView>
            <Authorized>
                <button type="button" class="btn-lock" @onclick="LockVault">
                    Lock Vault
                </button>
            </Authorized>
        </AuthorizeView>
    </header>

    <main class="main-container">
        @Body
    </main>
</div>

@code {
    private DateTime _lastActivityPing = DateTime.MinValue;

    private void OnUserInteraction()
    {
        var now = DateTime.UtcNow;
        if ((now - _lastActivityPing).TotalSeconds >= 1)
        {
            _lastActivityPing = now;
            Session.NotifyUserActivity();
        }
    }

    private void LockVault()
    {
        Session.Lock();
    }
}